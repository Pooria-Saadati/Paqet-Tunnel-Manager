[Unit]
Description=Paqet resource leak guard for %i
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PAQET_GUARD_ACTION=restart
Environment=PAQET_GUARD_PACKET_SOCKET_THRESHOLD=32
Environment=PAQET_GUARD_RSS_KB_THRESHOLD=524288
Environment=PAQET_GUARD_THREAD_THRESHOLD=64
Environment=PAQET_GUARD_FD_THRESHOLD=128
Environment=PAQET_GUARD_COOLDOWN_SECONDS=600
ExecStart=/usr/local/libexec/paqet-resource-guard %i

RuntimeDirectory=paqet-resource-guard
RuntimeDirectoryMode=0750
LogsDirectory=paqet-resource-guard
LogsDirectoryMode=0750

# This unit intentionally needs access to /proc and systemd in order to inspect
# and, only after an explicit threshold breach, restart the target Paqet unit.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/log/paqet-resource-guard /run/paqet-resource-guard
